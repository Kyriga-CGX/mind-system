{
    "$schema":  "https://opencode.ai/config.json",
    "plugin":  [
                   "opencode-vibeguard",
                   "@tarquinen/opencode-dcp@3.1.13"
               ],
    "skills":  {
                   "paths":  [
                                 "C:/Users/Kyrig/.agents/skills",
                                 "C:/Users/Kyrig/.config/opencode/mind/skills"
                             ]
               },
    "mcp":  {
                "context7":  {
                                 "type":  "remote",
                                 "url":  "https://mcp.context7.com/mcp",
                                 "enabled":  true,
                                 "headers":  {
                                                 "CONTEXT7_API_KEY":  "{env:CONTEXT7_API_KEY}"
                                             }
                             },
                "notion":  {
                               "type":  "stdio",
                               "command":  "npx",
                               "args":  [
                                            "-y",
                                            "@notionhq/notion-mcp-server"
                                        ],
                               "enabled":  false,
                               "env":  {
                                           "NOTION_API_KEY":  "${NOTION_API_KEY}",
                                           "NOTION_ROOT_PAGE_ID":  "${NOTION_ROOT_PAGE_ID}"
                                       }
                           },
                "google-sheets":  {
                                      "type":  "stdio",
                                      "command":  "npx",
                                      "args":  [
                                                   "-y",
                                                   "mcp-google-sheets"
                                               ],
                                      "enabled":  false,
                                      "env":  {
                                                  "GOOGLE_API_KEY":  "${GOOGLE_API_KEY}",
                                                  "GOOGLE_SHEETS_ID":  "${GOOGLE_SHEETS_ID}"
                                              }
                                  },
                "airtable":  {
                                 "type":  "stdio",
                                 "command":  "npx",
                                 "args":  [
                                              "-y",
                                              "@felores/airtable-mcp-server"
                                          ],
                                 "enabled":  false,
                                 "env":  {
                                             "AIRTABLE_API_KEY":  "${AIRTABLE_API_KEY}",
                                             "AIRTABLE_BASE_ID":  "${AIRTABLE_BASE_ID}"
                                         }
                             }
            }
}