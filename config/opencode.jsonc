{
    "$schema": "https://opencode.ai/config.json",
    "plugin": [
        "@tarquinen/opencode-dcp@3.2.0"
    ],
    "skills": {
        "paths": [
            "C:/Users/Kyrig/.agents/skills",
            "C:/Users/Kyrig/.config/opencode/mind/skills"
        ]
    },
    "mcp": {
        "context7": {
            "type": "remote",
            "url": "https://mcp.context7.com/mcp",
            "oauth": false,
            "headers": {
                "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
            }
        },
        "notion": {
            "type": "remote",
            "url": "https://mcp.notion.com/mcp"
        },
        "rea": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "rea-agents@latest",
                "mcp"
            ]
        }
    },
    "policies": [
        {
            "action": "tool.use",
            "resource": "read:*.env",
            "effect": "deny"
        },
        {
            "action": "tool.use",
            "resource": "edit:*.env",
            "effect": "deny"
        },
        {
            "action": "tool.use",
            "resource": "shell:git push --force*",
            "effect": "deny"
        },
        {
            "action": "tool.use",
            "resource": "shell:git push --force-with-lease*",
            "effect": "allow"
        },
        {
            "action": "tool.use",
            "resource": "shell:git clean -fdx*",
            "effect": "deny"
        },
        {
            "action": "tool.use",
            "resource": "shell:git reset --hard*",
            "effect": "deny"
        }
    ]
}
